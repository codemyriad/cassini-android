+SHERPA_ONNX_EXTERN_C JNIEXPORT jfloatArray JNICALL
+Java_com_k2fsa_sherpa_onnx_OfflineSpeakerDiarization_saveStreamingState(JNIEnv *env, jobject, jlong ptr) {
+  auto v = reinterpret_cast<sherpa_onnx::OfflineSpeakerDiarization *>(ptr)->SaveStreamingState();
+  auto ans = env->NewFloatArray(v.size());
+  if (ans) env->SetFloatArrayRegion(ans, 0, v.size(), v.data());
+  return ans;
+}
+SHERPA_ONNX_EXTERN_C JNIEXPORT jboolean JNICALL
+Java_com_k2fsa_sherpa_onnx_OfflineSpeakerDiarization_restoreStreamingState(JNIEnv *env, jobject, jlong ptr, jfloatArray values) {
+  jsize n = env->GetArrayLength(values);
+  if (n > 200000) return false;
+  std::vector<float> v(n);
+  env->GetFloatArrayRegion(values, 0, n, v.data());
+  if (env->ExceptionCheck()) return false;
+  return reinterpret_cast<sherpa_onnx::OfflineSpeakerDiarization *>(ptr)->RestoreStreamingState(v);
+}
