+std::vector<float> SortformerSpeakerCache::SaveState() const {
+  std::vector<float> ans = {1, static_cast<float>(config_.hidden_size),
+      static_cast<float>(config_.num_speakers), static_cast<float>(num_cache_frames_),
+      static_cast<float>(num_fifo_frames_), is_compressed_ ? 1.0f : 0.0f,
+      static_cast<float>(cache_probs_.size())};
+  ans.insert(ans.end(), cache_embeds_.begin(), cache_embeds_.end());
+  ans.insert(ans.end(), cache_probs_.begin(), cache_probs_.end());
+  ans.insert(ans.end(), fifo_.begin(), fifo_.end());
+  return ans;
+}
+bool SortformerSpeakerCache::RestoreState(const std::vector<float> &v) {
+  if (v.size() < 7 || v[0] != 1 || v[1] != config_.hidden_size || v[2] != config_.num_speakers) return false;
+  for (int i = 3; i <= 6; ++i) if (!std::isfinite(v[i]) || v[i] < 0 || v[i] != std::floor(v[i])) return false;
+  if (v[3] > config_.speaker_cache_length || v[4] > config_.fifo_length || v[5] > 1 || v[6] > v[3] * config_.num_speakers) return false;
+  int nc = static_cast<int>(v[3]), nf = static_cast<int>(v[4]), np = static_cast<int>(v[6]);
+  if (np != 0 && np != nc * config_.num_speakers) return false;
+  if (v[5] == 1 && np != nc * config_.num_speakers) return false;
+  size_t ne = nc * config_.hidden_size, nfe = nf * config_.hidden_size;
+  if (v.size() != 7 + ne + np + nfe) return false;
+  auto a = v.begin() + 7;
+  cache_embeds_.assign(a, a + ne); a += ne;
+  cache_probs_.assign(a, a + np); a += np;
+  fifo_.assign(a, v.end());
+  num_cache_frames_ = nc; num_fifo_frames_ = nf; is_compressed_ = v[5] == 1;
+  return true;
+}
