<?xml version="1.0" encoding="utf-8"?>
<!-- API28–30: includes require D2D, so cloud never selects notes or saved voices. -->
<full-backup-content>
    <include domain="file" path="cassini.db" requireFlags="deviceToDeviceTransfer" />
    <include domain="file" path="notes/" requireFlags="deviceToDeviceTransfer" />
    <include domain="file" path="voices/" requireFlags="deviceToDeviceTransfer" />
    <include domain="file" path="backup/manifest.json" requireFlags="deviceToDeviceTransfer" />
</full-backup-content>
