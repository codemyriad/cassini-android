<?xml version="1.0" encoding="utf-8"?>
<!-- Static ceiling only: the OFF build flag refuses cloud transport even with a persisted opt-in. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="cassini.db" />
        <include domain="file" path="notes/" />
        <include domain="file" path="voices/" />
        <include domain="file" path="backup/manifest.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="cassini.db" />
        <include domain="file" path="notes/" />
        <include domain="file" path="voices/" />
        <include domain="file" path="backup/manifest.json" />
    </device-transfer>
</data-extraction-rules>
