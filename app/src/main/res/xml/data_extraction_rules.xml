<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+: the library ceiling for both channels (D98). Cloud is skipped without client-side encryption; the agent
     emits only its allowlist and only for a channel the device-local choices permit (cloud backup, transfer and
     "Include saved voices in backups"). -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="cassini.db" />
        <include domain="file" path="notes/" />
        <include domain="file" path="voices/" />
        <include domain="file" path="backup/manifest.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="cassini.db" />
        <include domain="file" path="notes/" />
        <include domain="file" path="voices/" />
        <include domain="file" path="backup/manifest.json" />
    </device-transfer>
</data-extraction-rules>
