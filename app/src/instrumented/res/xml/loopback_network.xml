<?xml version="1.0" encoding="utf-8"?>
<!-- The instrumented build types only (debug, releaseTest): ModelDownloadDeviceTest serves a model host on the
     device's loopback over plain HTTP. Everything else stays HTTPS-only, as in the release build, which has no such
     configuration. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
