<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the entry points of scripts/device-kill-resume.sh (docs/architecture.md section 9). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Plain HTTP to 127.0.0.1 only, for ModelDownloadDeviceTest's loopback model host (src/instrumented/res). -->
    <application android:label="@string/debug_app_name" android:networkSecurityConfig="@xml/loopback_network"
        tools:replace="android:label">
        <!-- Exported so that adb shell am start reaches it; a release build has no such entry point. A visible
             start is also what lets it start the processing service on Android 12 and later. -->
        <activity android:name=".debug.DebugCommandActivity" android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" android:excludeFromRecents="true" />
        <!-- Starts the status writer in every process of a debug-root run, also one that Android starts for a
             redelivered service intent. -->
        <provider android:name=".debug.DebugStatusProvider" android:authorities="${applicationId}.debugstatus"
            android:exported="false" />
        <!-- compose-ui-tooling (the :ui previews) brings an exported activity that would start any composable of the
             app from outside. The app does not need it on a device. MissingClass: lint reads the compile classpath,
             and ui-tooling is only on the debug runtime classpath. -->
        <activity android:name="androidx.compose.ui.tooling.PreviewActivity" tools:node="remove"
            tools:ignore="MissingClass" />
        <!-- compose-ui-test-manifest brings an exported, empty activity for the device tests that show :ui screens
             (ScreenAccessibilityTest). The tests start it from the app's own process, so it need not be exported. -->
        <activity android:name="androidx.activity.ComponentActivity" android:exported="false"
            tools:replace="android:exported" />
        <!-- The device tests' "Open with" and share uris (src/instrumented): an authority that is not Cassini's own,
             as another app's provider has, so MainActivity takes it. It names the app after a prefix, so it is unique to
             each application id (an old build beside this one would otherwise refuse to install). Not exported. -->
        <provider android:name=".TestFilesProvider" android:authorities="testfiles.${applicationId}"
            android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/test_files" />
        </provider>
        <!-- Device-test callback source, enabled temporarily through adb notification-listener access. -->
        <service android:name=".testing.NotificationEvents" android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
