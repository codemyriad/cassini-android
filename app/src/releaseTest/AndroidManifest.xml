<?xml version="1.0" encoding="utf-8"?>
<!-- releaseTest builds only (the device tests of tag builds). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Plain HTTP to 127.0.0.1 only, for ModelDownloadDeviceTest's loopback model host (src/instrumented/res). -->
    <application android:networkSecurityConfig="@xml/loopback_network">
        <!-- compose-ui-test-manifest brings an exported, empty activity for the device tests that show :ui screens
             (ScreenAccessibilityTest). The tests start it from the app's own process, so it need not be exported. -->
        <activity android:name="androidx.activity.ComponentActivity" android:exported="false"
            tools:replace="android:exported" />
        <!-- The device tests' "Open with" and share uris (src/instrumented): an authority that is not Cassini's own,
             as another app's provider has, so MainActivity takes it. It names the app after a prefix, so it is unique to
             each application id (an old build beside this one would otherwise refuse to install). Not exported. -->
        <provider android:name=".TestFilesProvider" android:authorities="testfiles.${applicationId}"
            android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/test_files" />
        </provider>
    </application>
</manifest>
