.gradle/
.kotlin/
**/build/
local.properties
.idea/
*.iml
# No trailing slash: a worktree may link .tools to the main checkout's copy.
.tools
.claude/
.ruff_cache/
**/__pycache__/
# Repo-local Maven repository for the native AAR; scripts/setup.sh fills it.
native/m2/**
!native/m2/README.md
# Native outputs of 0.1.0 checkouts. Gradle no longer reads them; never commit them.
app/libs/
app/src/main/jniLibs/
*.pyc
*.wav
*.opus
dist/
**/.cxx/

# Device test audio. Only the CC-BY-4.0 FLEURS clip is committed (fixtures/README.md), so a recording
# copied next to it stays ignored. Local clips (tools/fetch-youtube-audio.sh) stay in
# app/src/androidTest/assets and are never committed.
fixtures/audio/*
!fixtures/audio/fleurs-it-short.*
app/src/androidTest/assets/
# Private meeting speaker fixtures (never commit)
tools/private-fixtures/
