# Device test audio. The CC-BY-4.0 FLEURS clip and the fixture trees are committed; local clips
# (tools/fetch-youtube-audio.sh) stay in app/src/androidTest/assets and are never committed.
# Only the named trees are exempt: a new tree, perhaps pulled from a real files/ directory, stays
# ignored until it is reviewed and listed here (fixtures/README.md).
!fixtures/audio/*
fixtures/filesdir/*
!fixtures/filesdir/empty/
!fixtures/filesdir/v0.0.4-style/
!fixtures/filesdir/v0.0.6-beta/
!fixtures/filesdir/v0.1.0-basic/
!fixtures/filesdir/v0.1.0-corrupt-library/
!fixtures/filesdir/v0.1.0-corrupt-library-new/
!fixtures/filesdir/v0.1.0-pre-library/
!fixtures/filesdir/v0.1.0-rec-crash/
!fixtures/filesdir/*/**
app/src/androidTest/assets/
# Private meeting speaker fixtures (never commit)
tools/private-fixtures/
