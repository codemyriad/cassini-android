<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon: the ink logo on bg, with a monochrome layer for themed icons (Android 13+). minSdk is 26,
     so mipmap-anydpi needs no -v26 qualifier. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ui_ic_launcher_background" />
    <foreground android:drawable="@drawable/ui_ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ui_ic_launcher_monochrome" />
</adaptive-icon>
